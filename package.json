{
  "name": "lumen",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Lumen, a personal knowledgebase: Markdown notes, Mermaid diagrams, drawings and images on Cloudflare Workers + D1 + KV/R2.",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "dev": "concurrently -k -n api,web -c blue,green \"wrangler dev --port 8787 --var LOCAL_DEV:true --local-upstream localhost:8787\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787 --var LOCAL_DEV:true --local-upstream localhost:8787",
    "build": "npm run typecheck && vite build",
    "start": "npm run build && wrangler dev --port 8787 --var LOCAL_DEV:true --local-upstream localhost:8787",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "The D1 database for your notes, folders, version history and search. It sets itself up on first run: no migrations to apply."
      },
      "FILES_KV": {
        "description": "Workers KV storage for images, attachments and drawings (1 GB on the free plan, no card needed). You can move uploads to R2 later; see the README."
      },
      "SETUP_PASSWORD": {
        "description": "Choose a password of **12 or more characters** (a few random words work well). You type it once, on your new Lumen's first page, to show it's yours; it isn't needed after that."
      }
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "katex": "^0.19.1",
    "linkify-it": "^6.1.0",
    "lucide-react": "^1.73.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "morphdom": "^2.7.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "7.2.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "6.2.8",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "nanoid@^3": "^3.3.20",
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    },
    "mermaid": {
      "katex": "$katex"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16",
      "mermaid": {
        "katex": "$katex"
      }
    }
  }
}
